# Server-side environment variables. Set them in
# Vercel > Project > Settings > Environment Variables. Never commit real values.

# Supabase > Project Settings > API (service_role / secret key bypasses RLS)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago > Your integrations > app > Production credentials
MP_ACCESS_TOKEN=
# Mercado Pago > app > Webhooks > Secret signature
MP_WEBHOOK_SECRET=

# Public base URL, no trailing slash (used for the webhook notification_url)
SITE_URL=https://rifa-campori.vercel.app

# Any long random string; salts the IP hash used for rate limiting
IP_HASH_SALT=
